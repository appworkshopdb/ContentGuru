# Kopieren nach .env (wird nicht eingecheckt). Hier niemals echte Zugangsdaten ablegen.

# Shadow-DB der JTL-Wawi auf der VM (nur Lesezugriff!)
SHADOW_DB_HOST=
SHADOW_DB_PORT=1433
SHADOW_DB_NAME=
SHADOW_DB_USER=
SHADOW_DB_PASSWORD=

# Erlaubte Herkunft des Frontends (CORS), z. B. die GitHub-Pages-Adresse
ALLOWED_ORIGIN=http://localhost:5173
